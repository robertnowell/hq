# The hub. Copy to .env.local. Nothing here is optional unless marked.

# Postgres, as the app role. NOT the owner: the app refuses to start on a role
# that bypasses row-level security (lib/db.ts). Apply db/schema.sql and the
# numbered migrations as the owner, then create hq_app (see db/README.md).
HQ_APP_DATABASE_URL=postgres://hq_app:...@host/db?sslmode=require

# Clerk. Sign-in is an email code; no password. Any Clerk app works.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Documents and images live in a Google Cloud Storage bucket, not the database.
HQ_GCS_SA_KEY_B64=...            # service-account JSON, base64
HQ_GCS_BUCKET=my-hub-documents
HQ_MEDIA_BUCKET=my-hub-media     # optional; defaults to HQ_GCS_BUCKET
HQ_MEDIA_BASE=https://storage.googleapis.com/my-hub-media   # optional

# Where shared pages are read. HQ_HUB_BASE is this deployment's own /p path.
# HQ_PUBLIC_BASE and HQ_SITE_OWNER_USER_ID connect ONE account's shares to a
# personal site that renders the feed; leave unset if nobody has one.
HQ_HUB_BASE=https://hub.example.com/p
# HQ_PUBLIC_BASE=https://example.com/notes
# HQ_SITE_OWNER_USER_ID=

# Optional. A fast model reads a page before it is shared and may ask the
# person to look again. Unset means the check does not run and sharing is not
# blocked.
# HQ_ANTHROPIC_API_KEY=

# Optional, Tranquility Base only: the credits gateway and billing. Leave unset
# to run the hub as a documents archive alone.
# HQ_GATEWAY_BASE=
# HQ_GATEWAY_ISSUER=
# HQ_GATEWAY_SERVICE_TOKEN=
# HQ_GATEWAY_SIGNING_JWK=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CRON_SECRET=
# RECONCILE_HEARTBEAT_URL=

# Development only. Stands in for a signed-in person when there is no Clerk
# session; ignored in production.
# HQ_DEV_USER=dev-user-1
# HQ_DEV_EMAIL=dev@example.com
